   "cell_type": "markdown",
   "id": "b08bd07d",
   "metadata": {},
   "source": [
    "#### Utilidades\n",
    "\n",
    "Define `sh()`, la función que ejecuta comandos de shell mostrando su salida en vivo, y calcula la ruta raíz del proyecto"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "315e5499",
   "metadata": {},
   "outputs": [],
   "source": [
    "def sh(cmd):\n",
    "    p = subprocess.Popen(cmd, shell=True, cwd=proyecto, stdout=subprocess.PIPE,\n",
    "                         stderr=subprocess.STDOUT, text=True, bufsize=1)\n",
    "    for linea in p.stdout:\n",
    "        print(linea, end=\"\")\n",
    "\n",
    "    p.wait()\n",
    "\n",
    "    if p.returncode != 0:\n",
    "        raise RuntimeError(p.returncode)\n",
    "\n",
    "proyecto = Path.cwd()\n",
    "if not (proyecto / \"docker-compose.yml\").exists() and (proyecto.parent / \"docker-compose.yml\").exists():\n",
    "    proyecto = proyecto.parent"
   ]
  },
